# ================================================================
# Outline Wiki - Environment Configuration
# TLS/SSL: Let's Encrypt / Self-Signed (terminated by Nginx)
# ================================================================

NODE_ENV=production

# Domain name (DNS must point to this server)
OUTLINE_HOST=outline.cloudsb.space

# SSL Certificate Type: 'letsencrypt' hoặc 'self-signed'
SSL_TYPE=letsencrypt

# Secret keys (sinh ngẫu nhiên bằng `openssl rand -hex 32`)
SECRET_KEY=
UTILS_SECRET=

# Database & Redis (Host networking mode)
DATABASE_URL=postgres://admin:123qweaA@localhost:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://localhost:6379

# Fully qualified public URL
URL=https://outline.cloudsb.space
PORT=3333

# Storage
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Authentication (Google / Slack / Azure / OIDC)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_URI=
# OIDC_TOKEN_URI=
# OIDC_USERINFO_URI=

# Notion Import
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

FORCE_HTTPS=false
DEFAULT_LANGUAGE=en_US
